#!/bin/sh
# Bypass Failover v1.3.0-rc1 (OpenWrt 24.10 / fw4) - IPv4 only.
# Installed ONLY on the primary OpenWrt. Disabled by default.
set -u
CFG=/etc/config/bypass_failover
STATE=/tmp/bypass-failover.state
PID=/var/run/bypass-failover.pid
LOG=/tmp/bypass-failover.log
TABLE=201
MARK=0x4246
NFT=bypass_failover
TEST_TABLE=202
TEST_MARK=0x4247
TEST_NFT=bypass_failover_test
TEST_EXP=/tmp/bypass-failover-test.expires
TEST_PID=/tmp/bypass-failover-test-watchdog.pid
FULL_OWNED=/tmp/bypass-failover-route.owned
REDIRECT_SAVE=/tmp/bypass-failover-send-redirects.old
PROBE_TABLE=203
PROBE_MARK=0x4248
PROBE_NFT=bypass_failover_probe
PROBE_LOCK=/tmp/bypass-failover-probe.lock
SAFE_TEST_DIR=/tmp/bypass-failover-safe-rollback
SAFE_TEST_LAST=/tmp/bypass-failover-safe-last
safe_test_stop() {
 if [ -d "$SAFE_TEST_DIR" ]; then
  safe_test_cleanup
  rm -f "$SAFE_TEST_DIR/deadline" "$SAFE_TEST_DIR/pid" "$SAFE_TEST_DIR/owned"
  rmdir "$SAFE_TEST_DIR" 2>/dev/null || true
  printf 'stopped\n' > "$SAFE_TEST_LAST"
  say '安全回滚测试：已手动停止；未修改任何路由或防火墙规则'
 fi
}
safe_test_resources() {
 [ ! -e "$TEST_EXP" ] &&
 [ ! -f "$FULL_OWNED" ] &&
 ! nft list table inet "$TEST_NFT" >/dev/null 2>&1 &&
 ! ip -4 rule show | grep -q '^10200:' &&
 [ -z "$(ip -4 route show table "$TEST_TABLE" 2>/dev/null)" ] &&
 ! nft list table inet bypass_failover_dryrun >/dev/null 2>&1 &&
 ! ip -4 rule show | grep -q '^10209:' &&
 [ -z "$(ip -4 route show table 209 2>/dev/null)" ]
}
safe_test_cleanup() {
 # The dry-run uses its own unique table, mark and priority.
 # The nft chain has no hooks, so no client can match it.
 [ -d "$SAFE_TEST_DIR" ] || return 0
 if [ -f "$SAFE_TEST_DIR/owned" ]; then
  nft delete table inet bypass_failover_dryrun 2>/dev/null || true
  ip -4 rule del priority 10209 fwmark 0x42fe table 209 2>/dev/null || true
  ip -4 route flush table 209 2>/dev/null || true
 fi
}
safe_test_install() {
 # Route table 209 is never selected by normal traffic; fwmark 0x42fe
 # is not set by any hook. No live traffic is rerouted.
 safe_test_resources || return 1
 : > "$SAFE_TEST_DIR/owned"
 ip -4 route add unreachable default table 209 || return 1
 ip -4 rule add priority 10209 fwmark 0x42fe table 209 || return 1
 nft -f - <<'DRYRUN_NFT'
table inet bypass_failover_dryrun {
 chain inspection_only {
  counter
 }
}
DRYRUN_NFT
}

safe_test_finish() {
 expected=$1
 [ -d "$SAFE_TEST_DIR" ] || return 0
 [ "$(cat "$SAFE_TEST_DIR/deadline" 2>/dev/null)" = "$expected" ] || return 0
 safe_test_cleanup
 rm -f "$SAFE_TEST_DIR/deadline" "$SAFE_TEST_DIR/pid" "$SAFE_TEST_DIR/owned"
 rmdir "$SAFE_TEST_DIR" 2>/dev/null || true
 if safe_test_resources; then
  printf 'passed\n' > "$SAFE_TEST_LAST"
  say '安全回滚测试：60 秒到期，后台执行清理；真实转发规则无残留，验收通过（不代表真实引流回滚通过）'
 else
  printf 'failed\n' > "$SAFE_TEST_LAST"
  say '安全回滚测试：60 秒到期，但发现转发测试资源或规则占用；验收未通过，未删除无法确定所有权的规则'
 fi
}
safe_test_worker() {
 deadline=$1
 # The worker is cancelled via its owned directory, not an unreliable PID file.
 while [ -d "$SAFE_TEST_DIR" ] && [ "$(cat "$SAFE_TEST_DIR/deadline" 2>/dev/null)" = "$deadline" ]; do
  now=$(date +%s)
  if [ "$now" -ge "$deadline" ]; then safe_test_finish "$deadline"; return; fi
  sleep 2
 done
}
safe_test_start() {
 [ "$(val mode direct)" = direct ] || { echo 'Safe test requires direct mode' >&2; return 1; }
 [ ! -d "$SAFE_TEST_DIR" ] || { echo 'Safe test already running' >&2; return 1; }
 safe_test_resources || { echo 'Test resources not clean; refusing to run' >&2; return 1; }
 mkdir "$SAFE_TEST_DIR" || return 1
 deadline=$(( $(date +%s) + 60 ))
 printf '%s\n' "$deadline" > "$SAFE_TEST_DIR/deadline"
 if ! safe_test_install; then
  safe_test_cleanup
  rm -f "$SAFE_TEST_DIR/deadline" "$SAFE_TEST_DIR/owned"
  rmdir "$SAFE_TEST_DIR" 2>/dev/null || true
  echo 'Cannot install isolated rehearsal rules' >&2
  return 1
 fi
 printf 'running\n' > "$SAFE_TEST_LAST"
 ( "$0" safe-test-worker "$deadline" </dev/null >/dev/null 2>&1 & )
 say "安全回滚测试启动：60 秒倒计时，截止时间戳=$deadline；仅创建无 hook 的隔离 nft 表和不匹配真实流量的策略路由；不改变客户端网络"
 echo started
}
safe_test_status() {
 if [ -d "$SAFE_TEST_DIR" ]; then
  deadline=$(cat "$SAFE_TEST_DIR/deadline" 2>/dev/null || echo 0)
  case "$deadline" in ''|*[!0-9]*) deadline=0;; esac
  remaining=$((deadline - $(date +%s)))
  if [ "$remaining" -le 0 ]; then
   safe_test_finish "$deadline"
  else
   echo running
   echo "remaining=$remaining"
   return 0
  fi
 fi
 cat "$SAFE_TEST_LAST" 2>/dev/null || echo idle
}
val() { uci -q get "bypass_failover.main.$1" 2>/dev/null || printf '%s' "$2"; }
say() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; tail -n 400 "$LOG" > "$LOG.new"; mv "$LOG.new" "$LOG"; }
notify() {
  url=$(val webhook '')
  case "$url" in https://*) ;; *) return 0;; esac
  payload=$(jq -nc --arg text "$1" '{text:$text}') || return 0
  curl -fLsS --connect-timeout 3 --max-time 6 -H 'Content-Type: application/json' -d "$payload" "$url" >/dev/null 2>&1 || say 'Webhook 通知发送失败'
}
valid_ip() { case "$1" in ''|*[!0-9.]*|.*|*..*|*.) return 1;; esac; echo "$1" | awk -F. 'NF==4 {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255 || length($i)>3) exit 1; exit 0} {exit 1}'; }
check_config() {
  PRIMARY=$(val primary '')
  [ -n "$PRIMARY" ] || PRIMARY=$(uci -q get network.lan.ipaddr || true)
  BYPASS=$(val bypass '')
  LAN=$(val lan br-lan)
  INTERVAL=$(val interval 10)
  FAIL=$(val fail_count 3)
  RECOVER=$(val recover_count 5)
  HOLD=$(val hold_seconds 120)
  for ip in "$PRIMARY" "$BYPASS"; do valid_ip "$ip" || { say "无效 IP: $ip"; return 1; }; done
  [ "$PRIMARY" != "$BYPASS" ] || return 1
  ip link show "$LAN" >/dev/null 2>&1 || { say 'LAN interface not found'; return 1; }
  ip -4 addr show dev "$LAN" | grep -Fq "$PRIMARY/" || { say '主路由LAN地址不匹配'; return 1; }
  ip -4 route get "$BYPASS" | grep -q "dev $LAN" || { say '旁路由不在指定 LAN'; return 1; }
  for n in "$INTERVAL" "$FAIL" "$RECOVER" "$HOLD"; do case "$n" in ''|*[!0-9]*) return 1;; esac; done
  [ "$INTERVAL" -ge 5 ] && [ "$FAIL" -ge 2 ] && [ "$RECOVER" -ge 2 ] && [ "$HOLD" -ge 30 ] || return 1
}
# Probe a router-originated HTTPS request through the bypass's existing
# transparent TCP path. Uses only one destination IPv4 and a dedicated policy
# rule, and does not require a remotely reachable SOCKS listener.
probe_clear() {
  # Do not touch a third-party route table or rule that happens to use 203.
  if [ -d "$PROBE_LOCK" ] || nft list table inet "$PROBE_NFT" >/dev/null 2>&1; then
    nft delete table inet "$PROBE_NFT" 2>/dev/null || true
    while ip -4 rule show | grep -Eq '^10202:.*fwmark 0x4248 .*lookup 203'; do
      ip -4 rule del priority 10202 fwmark "$PROBE_MARK" table "$PROBE_TABLE" 2>/dev/null || break
    done
    ip -4 route flush table "$PROBE_TABLE" 2>/dev/null || true
    rmdir "$PROBE_LOCK" 2>/dev/null || true
  fi
}
probe_ip() {
  curl -4 -fsS --connect-timeout 3 --max-time 8 --interface "$LAN" \
    --resolve one.one.one.one:443:1.1.1.1 \
    'https://one.one.one.one/cdn-cgi/trace' 2>/dev/null |
    sed -n 's/^ip=//p' | tr -d '\r' | head -n 1
}
# Check bypass-routed HTTPS without requiring the *direct* path to reach
# Cloudflare. This proves only that a TCP request succeeded over a marked
# route; it is NOT evidence of a proxy exit or client return-path correctness.
probe_transparent() (
  [ -d "$PROBE_LOCK" ] && return 1
  [ -z "$(ip -4 route show table "$PROBE_TABLE" 2>/dev/null)" ] || return 1
  ip -4 rule show | grep -q '^10202:' && return 1
  nft list table inet "$PROBE_NFT" >/dev/null 2>&1 && return 1
  mkdir "$PROBE_LOCK" 2>/dev/null || return 1
  trap 'probe_clear' EXIT
  trap 'probe_clear; exit 1' INT TERM
  ip -4 route replace default via "$BYPASS" dev "$LAN" table "$PROBE_TABLE" || return 1
  if ! nft -f - <<EOF
table inet $PROBE_NFT {
 chain output_mark {
  type route hook output priority mangle; policy accept;
  ip saddr $PRIMARY ip daddr 1.1.1.1 meta l4proto tcp tcp dport 443 meta mark 0x0 counter meta mark set $PROBE_MARK
 }
}
EOF
  then return 1; fi
  ip -4 rule add priority 10202 fwmark "$PROBE_MARK" table "$PROBE_TABLE" || return 1
  bypass_ip=$(probe_ip)
  valid_ip "$bypass_ip" || { say '旁路由路径 HTTPS 探测失败，保持直连'; return 1; }
  packets=$(nft list chain inet "$PROBE_NFT" output_mark 2>/dev/null |
    awk '/counter packets/{for(i=1;i<=NF;i++) if($i=="packets"){print $(i+1); exit}}')
  case "$packets" in ''|*[!0-9]*) return 1;; esac
  [ "$packets" -gt 0 ] || return 1
  say "旁路由标记路径 HTTPS 可达（出口 $bypass_ip），但未证明代理出口或客户端回程"
)

# Tool-agnostic two-stage monitor. The HTTPS request is policy-routed to
# the side router and never infers success from the primary's ordinary WAN.
# This tests the router-originated path, NOT the client return path.
# The actual switching gate remains locked until client path acceptance.
health_report() {
 say '网络检测开始：主路由直连模式下检查旁路由状态'
 check_config || { say '网络检测失败：配置校验未通过'; echo 'config=invalid'; return 1; }
 say '阶段1：检查旁路由 ICMP 连通性'
 if ! ping -c 1 -W 2 "$BYPASS" >/dev/null 2>&1; then
  say '阶段1失败：旁路由 ICMP 无响应；跳过 HTTPS 检测；保持直连'
  echo 'side=offline'
  echo 'external=skipped'
  echo 'decision=direct'
  echo 'client_return_path=unverified'
  return 1
 fi
 echo 'side=online'
 if ! nslookup www.baidu.com "$BYPASS" >/dev/null 2>&1; then
  say '旁路由 DNS 检测失败，保持或恢复主路由直连'
  echo 'dns=unavailable'
  echo 'external=skipped'
  echo 'decision=direct'
  echo 'client_return_path=unverified'
  return 1
 fi
 echo 'dns=reachable'
 say '阶段1成功：旁路由 DNS 可达；阶段2开始：经旁路由 HTTPS 检测'
 if probe_transparent; then
  say '阶段2成功：HTTPS 路径可达；客户端回程仍未验收；保持直连'
  echo 'external=reachable_via_side_route'
  echo 'decision=side_candidate'
  echo 'client_return_path=unverified'
  return 0
 fi
 say '阶段2失败或未确认：HTTPS 路径不可用；保持直连'
 echo 'external=unreachable_or_unverified'
 echo 'decision=direct'
 echo 'client_return_path=unverified'
 return 1
}
# The daemon reads the same two-stage result but must NEVER permit auto
# routing while an actual client end-to-end test has not been accepted.
health() {
 health_report >> "$LOG" 2>/dev/null
}
check_base() {
  ping -c 1 -W 2 "$BYPASS" >/dev/null 2>&1 &&
    nslookup www.baidu.com "$BYPASS" >/dev/null 2>&1
}
# Linux can tell same-LAN clients to bypass the primary router via ICMP
# Redirect. Save both knobs (the effective value uses max(all, interface)).
redirects_restore() {
  [ -f "$REDIRECT_SAVE" ] || return 0
  read was_all was_lan < "$REDIRECT_SAVE" || return 1
  all=/proc/sys/net/ipv4/conf/all/send_redirects
  one=/proc/sys/net/ipv4/conf/"$(val lan br-lan)"/send_redirects
  case "$was_all:$was_lan" in 0:0|0:1|1:0|1:1) ;; *) return 1;; esac
  [ -w "$all" ] && [ -w "$one" ] || return 1
  [ "$(cat "$all")" = 0 ] && printf '%s\n' "$was_all" > "$all"
  [ "$(cat "$one")" = 0 ] && printf '%s\n' "$was_lan" > "$one"
  rm -f "$REDIRECT_SAVE"
}
redirects_disable() {
  all=/proc/sys/net/ipv4/conf/all/send_redirects
  one=/proc/sys/net/ipv4/conf/"$LAN"/send_redirects
  [ -r "$all" ] && [ -r "$one" ] && [ -w "$all" ] && [ -w "$one" ] || return 1
  if [ ! -f "$REDIRECT_SAVE" ]; then
    printf '%s %s\n' "$(cat "$all")" "$(cat "$one")" > "$REDIRECT_SAVE" || return 1
  fi
  printf '0\n' > "$all" || { redirects_restore; return 1; }
  printf '0\n' > "$one" || { redirects_restore; return 1; }
  [ "$(cat "$all")" = 0 ] && [ "$(cat "$one")" = 0 ]
}
# Never flush unowned routing table 201 or rules from another service.
# The nft table has a reserved name but an unrelated table must not be deleted.
owned_full() { [ -f "$FULL_OWNED" ]; }
route_guard() {
 if ! owned_full; then
  if nft list table inet "$NFT" >/dev/null 2>&1 ||
     ip -4 rule show | grep -q '^10201:' ||
     [ -n "$(ip -4 route show table "$TABLE" 2>/dev/null)" ]; then
   echo 'routing_resource_conflict=present'
   return 1
  fi
 fi
 echo 'routing_resource_conflict=none'
}
clear_route() {
 if owned_full; then
  nft delete table inet "$NFT" 2>/dev/null || say '撤销自有 nft 表失败'
  while ip -4 rule show | grep -Eq '^10201:.*fwmark 0x4246 .*lookup 201'; do
   ip -4 rule del priority 10201 fwmark "$MARK" table "$TABLE" 2>/dev/null || break
  done
  ip -4 route flush table "$TABLE" 2>/dev/null || say '自有路由表清理失败'
  rm -f "$FULL_OWNED"
  redirects_restore || say '恢复 ICMP Redirect 原配置失败'
 else
  # Even a crashed previous beta must not trigger deletion of third-party
  # resources on reboot or a button click.
  [ ! -f "$REDIRECT_SAVE" ] || say '缺少路由所有权标识：不自动恢复不确定的共享 sysctl'
 fi
 echo direct > "$STATE"
}
# A down or missing side next hop must never select an empty policy table
# as a blackhole. This is the primary-only fallback-to-main invariant.
fallback_audit() {
 if owned_full; then echo 'policy_ownership=ours'; else echo 'policy_ownership=none'; fi
 route_guard || true
 echo 'fallback_policy=main'
 echo 'client_forwarding=locked_until_end_to_end_verified'
}
# Runtime integrity: routing, NAT and rule must be present together.
# Do not mistake a stale marker or an empty policy table for active routing.
full_route_intact() {
 owned_full || return 1
 nft list chain inet "$NFT" mark_in >/dev/null 2>&1 || return 1
 nft list chain inet "$NFT" dns_to_side >/dev/null 2>&1 || return 1
 nft list chain inet "$NFT" dns_return >/dev/null 2>&1 || return 1
 ip -4 rule show | grep -Eq '^10201:.*fwmark 0x4246 .*lookup 201' || return 1
 ip -4 route show table "$TABLE" | grep -Fq "default via $(val bypass '') dev $(val lan br-lan)" || return 1
}
use_bypass() {
  [ ! -f "$TEST_EXP" ] || { echo 'test in progress'; return 1; }
  # Fail closed to direct: build policy table before mark rule. Exclude router itself,
  # LAN/subnet destinations and all traffic originating at BYPASS.
  # Experimental automatic traffic path. No SNAT; return path goes directly
  # from side router to client on same L2 network.
  # A single-arm bypass can emit return frames with an Internet source IP.
  # Exclude its layer-2 MAC, not just its IPv4 address, to avoid recirculation.
  ping -c 1 -W 2 "$BYPASS" >/dev/null 2>&1 || return 1
  bypass_mac=$(ip neigh show "$BYPASS" dev "$LAN" | awk '{for(i=1;i<NF;i++) if($i=="lladdr"){print $(i+1); exit}}')
  case "$bypass_mac" in
    ??:??:??:??:??:??) ;;
    *) say '无法确认旁路由 MAC，保持主路由直连'; return 1 ;;
  esac
  clear_route
  # Never overwrite tables/rules reserved by a different service.
  [ -z "$(ip -4 route show table "$TABLE" 2>/dev/null)" ] || return 1
  ip -4 rule show | grep -q '^10201:' && return 1
  nft list table inet "$NFT" >/dev/null 2>&1 && return 1
  : > "$FULL_OWNED"
  redirects_disable || { clear_route; return 1; }
  # Side must be able to answer DNS on :53 before intercepting LAN queries.
  # Do not activate a broken DNS redirection and strand all clients.
  if ! nslookup www.baidu.com "$BYPASS" >/dev/null 2>&1; then
    say "旁路由 DNS :53 不可用，保持主路由直连"
    clear_route; return 1
  fi
  ip -4 route replace default via "$BYPASS" dev "$LAN" table "$TABLE" || { clear_route; return 1; }
  nft -f - <<EOF
table inet $NFT {
 chain mark_in {
  type filter hook prerouting priority mangle; policy accept;
  iifname "$LAN" ether saddr != $bypass_mac meta mark 0x0 meta l4proto { tcp, udp } ip saddr != $BYPASS ip saddr != $PRIMARY ip daddr != 192.168.0.0/16 ip daddr != 10.0.0.0/8 ip daddr != 172.16.0.0/12 ip daddr != 127.0.0.0/8 ip daddr != 169.254.0.0/16 ip daddr != 224.0.0.0/4 meta mark set $MARK counter
 }
 chain observe_to_side {
  type filter hook postrouting priority mangle; policy accept;
  oifname "$LAN" meta mark $MARK ip saddr != $PRIMARY counter
 }
 # NAT only client DNS, never the entire proxy flow: preserve real client IP
 # for Mihomo's rules, avoid accidental LAN return-path changes.
 chain dns_to_side {
  type nat hook prerouting priority dstnat; policy accept;
  iifname "$LAN" ether saddr != $bypass_mac ip saddr != $BYPASS ip daddr $PRIMARY meta l4proto { tcp, udp } th dport 53 counter dnat ip to $BYPASS
 }
 chain dns_return {
  type nat hook postrouting priority srcnat; policy accept;
  oifname "$LAN" ip daddr $BYPASS ip saddr != $PRIMARY meta l4proto { tcp, udp } th dport 53 counter snat ip to $PRIMARY
 }
}
EOF
  if ! nft list table inet "$NFT" >/dev/null 2>&1; then clear_route; return 1; fi
  if ! ip -4 rule add priority 10201 fwmark "$MARK" table "$TABLE"; then clear_route; return 1; fi
  # Confirm marked client lookups select the actual side next hop before
  # reporting success. This is a routing assertion, not end-to-end proof.
  probe_client=$(val test_client '')
  valid_ip "$probe_client" || probe_client="$PRIMARY"
  route_check=$(ip -4 route get 1.1.1.1 from "$probe_client" iif "$LAN" mark "$MARK" 2>&1)
  case "$route_check" in
    *"via $BYPASS dev $LAN"*) ;;
    *) say "全屋策略路由核验失败：$route_check"; clear_route; return 1 ;;
  esac
  say "已启用全屋 TCP/UDP 引流与客户端 DNS 重定向：LAN $LAN -> $BYPASS；不修改 DHCP；真实客户端回程尚需验收"
  echo bypass > "$STATE"
}
test_clear() {
 # Remove only our marker/chain and our specifically marked policy rule.
 if [ -f "$TEST_EXP" ] || nft list table inet "$TEST_NFT" >/dev/null 2>&1 ||
    ip -4 rule show | grep -Eq '^10200:.*fwmark 0x4247 .*lookup 202'; then
   nft delete table inet "$TEST_NFT" 2>/dev/null || true
   while ip -4 rule show | grep -Eq '^10200:.*fwmark 0x4247 .*lookup 202'; do
     ip -4 rule del priority 10200 fwmark "$TEST_MARK" table "$TEST_TABLE" 2>/dev/null || break
   done
   ip -4 route flush table "$TEST_TABLE" 2>/dev/null || true
   rm -f "$TEST_EXP"
   redirects_restore || say '恢复 ICMP Redirect 原配置失败'
 fi
}
# Read only our temporary nft counters; values are reset with the test table.
test_packets() {
 nft -a list chain inet "$TEST_NFT" "$1" 2>/dev/null |
   awk '/counter packets/{for(i=1;i<=NF;i++) if($i=="packets"){print $(i+1); exit}}'
}
# Read-only audit: learn from shunt's route-table conflict protection and
# explicit gateway resolution. Never touch the other router or PassWall.
# This is a configuration / L3 inspection, NOT end-to-end acceptance.
topology_audit() {
 check_config || { echo 'topology=config_invalid'; return 1; }
 echo 'topology=single_arm_lan'
 echo "primary=$PRIMARY"
 echo "bypass=$BYPASS"
 echo "lan=$LAN"
 echo 'deployment=primary_only'
 echo 'side_package_required=no'
 echo 'dhcp_changes=none'
 echo 'proxy_port_exposure=none'
 echo "primary_default=$(ip -4 route show default | head -n 1)"
 echo "side_gateway_reachable=$(if ping -c 1 -W 1 "$BYPASS" >/dev/null 2>&1; then echo yes; else echo no; fi)"
 echo "main_route=$(ip -4 route get 1.1.1.1 2>/dev/null | head -n 1)"
 echo "candidate_policy_route=default via $BYPASS dev $LAN"
 echo "router_forwarding=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo unknown)"
 echo "redirects_all=$(cat /proc/sys/net/ipv4/conf/all/send_redirects 2>/dev/null || echo unknown)"
 echo "redirects_lan=$(cat "/proc/sys/net/ipv4/conf/$LAN/send_redirects" 2>/dev/null || echo unknown)"
 if ip -4 rule show | grep -q '^10201:'; then echo 'policy_priority_10201=occupied'; else echo 'policy_priority_10201=free'; fi
 if ip -4 rule show | grep -q '^10200:'; then echo 'test_priority_10200=occupied'; else echo 'test_priority_10200=free'; fi
 if [ -n "$(ip -4 route show table "$TABLE" 2>/dev/null)" ]; then echo 'policy_table_201=occupied'; else echo 'policy_table_201=free'; fi
 if nft list table inet "$NFT" >/dev/null 2>&1; then echo 'policy_nft_table=exists'; else echo 'policy_nft_table=absent'; fi
 if nft list table inet "$TEST_NFT" >/dev/null 2>&1; then echo 'test_nft_table=exists'; else echo 'test_nft_table=absent'; fi
 echo 'side_passwall_capture=not_observable'
 echo 'side_direct_return=not_observable'
 echo 'verified_client_connectivity=no'
 echo 'auto_enable=safety_locked'
}
test_status() {
 # If the detached rollback worker has disappeared, immediately withdraw any
 # temporary forwarding instead of waiting for the nominal deadline.
 if nft list table inet "$TEST_NFT" >/dev/null 2>&1; then
  if [ ! -f "$TEST_EXP" ] || [ ! -f "$TEST_PID" ] ||
     ! kill -0 "$(cat "$TEST_PID" 2>/dev/null)" 2>/dev/null; then
   test_clear
   say '临时测试看门狗异常，已尝试撤销引流规则'
   echo "test=rolled_back"
   return
  fi
 fi
 if [ -f "$TEST_EXP" ]; then
  until=$(cat "$TEST_EXP" 2>/dev/null || echo 0)
  case "$until" in *[!0-9]*|'') until=0;; esac
  remain=$((until-$(date +%s)))
  if [ "$remain" -gt 0 ] && nft list table inet "$TEST_NFT" >/dev/null 2>&1; then
   echo "test=running"; echo "test_remaining=$remain"; echo "test_client=$(val test_client '')"
   echo "test_packets=$(test_packets mark_test)"
   echo "test_egress_packets=$(test_packets test_egress)"
   return
  fi
  test_clear
 fi
 echo "test=idle"
}
test_watchdog() {
 expected=$1
 echo "$$" > "$TEST_PID"
 bypass_failures=0
 while :; do
  [ -f "$TEST_EXP" ] || break
  expires=$(cat "$TEST_EXP" 2>/dev/null || echo 0)
  [ "$expires" = "$expected" ] || break
  now=$(date +%s)
  [ "$now" -lt "$expires" ] || { test_clear; say '单设备测试到期，已自动撤销规则'; break; }
  bypass_addr=$(val bypass '')
  if ping -c 1 -W 1 "$bypass_addr" >/dev/null 2>&1; then
    bypass_failures=0
  else
    bypass_failures=$((bypass_failures+1))
    if [ "$bypass_failures" -ge 3 ]; then
      say '真实引流测试：旁路由连续三次无响应，提前撤销'
      test_clear
      break
    fi
  fi
  # If packets match the client but none reach postrouting after 12s,
  # abort early rather than holding a broken connection for 60s.
  if [ $((expires-now)) -le 48 ]; then
    ingress=$(test_packets mark_test)
    egress=$(test_packets test_egress)
    case "$ingress:$egress" in *[!0-9:]*|:*|*:) ;; *)
      if [ "$ingress" -gt 0 ] && [ "$egress" -eq 0 ]; then
        say "单设备测试检测到转发异常：入口 $ingress 包、转发出口 0 包，提前撤销引流"
        test_clear
        break
      fi ;;
    esac
  fi
  sleep 2
 done
 rm -f "$TEST_PID"
}
test_start() {
 # Opt-in single-client trial: only a single fixed HTTPS target is redirected.
 # No SNAT: let the side router respond directly to the LAN client.
 # Automatic rollback and one-click test-stop are mandatory.
 [ "$(mode)" = direct ] || { echo 'only permitted in direct mode' >&2; return 1; }
 [ ! -f "$TEST_EXP" ] || { echo 'test already running; stop first' >&2; return 1; }
 check_config || return 1
 client=$(val test_client '')
 valid_ip "$client" || { echo 'test client IP not configured' >&2; return 1; }
 [ "$client" != "$PRIMARY" ] && [ "$client" != "$BYPASS" ] || return 1
 # Never test an address outside the directly connected LAN, including the
 # primary router, side router, and addresses not present in the neighbor table.
 # IPv4-only neighbour lookup, with a brief ARP refresh if the cache is cold.
 # Never infer a device MAC from another interface or IP.
 client_mac=$(ip -4 neigh show to "$client" dev "$LAN" 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="lladdr"){print $(i+1); exit}}')
 if [ -z "$client_mac" ]; then
   ping -c 1 -W 1 "$client" >/dev/null 2>&1 || true
   client_mac=$(ip -4 neigh show to "$client" dev "$LAN" 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="lladdr"){print $(i+1); exit}}')
 fi
 case "$client_mac" in
   ??:??:??:??:??:??) ;;
   *)
     echo "test client MAC not resolved: configured_ip=$client lan=$LAN; neighbour=$(ip -4 neigh show to "$client" dev "$LAN" 2>/dev/null)" >&2
     return 1 ;;
 esac
 ip -4 route get "$client" | grep -q "dev $LAN" || { echo 'test client not in LAN' >&2; return 1; }
 # Transparent TCP mode can be tested without exposing an HTTP/SOCKS listener.
 # This is a BASE connectivity prerequisite, not a proof of proxy egress.
 ping -c 1 -W 2 "$BYPASS" >/dev/null 2>&1 || { echo 'bypass connectivity check failed' >&2; return 1; }
 # Do not claim a successful proxy or forwarding result before a real client test.
 mac=$(ip neigh show "$BYPASS" dev "$LAN" | awk '{for(i=1;i<NF;i++) if($i=="lladdr"){print $(i+1); exit}}')
 case "$mac" in
  ??:??:??:??:??:??) ;;
  *) echo 'cannot determine bypass MAC (anti-loop prerequisite)' >&2; return 1;;
 esac
 # Refuse to clobber an existing policy table or rule managed by another app.
 [ -z "$(ip -4 route show table "$TEST_TABLE" 2>/dev/null)" ] || { echo 'test routing table is already occupied' >&2; return 1; }
 ip -4 rule show | grep -q '^10200:' && { echo 'test rule priority is occupied' >&2; return 1; }
 nft list table inet "$TEST_NFT" >/dev/null 2>&1 && { echo 'test nft table already exists' >&2; return 1; }
 deadline=$(($(date +%s)+60))
 echo "$deadline" > "$TEST_EXP"
 # Suppress redirects only during the temporary test and restore afterwards.
 redirects_disable || { test_clear; return 1; }
 # Install independent, TEST ONLY rules; never touch production table 201.
 # Marking excludes frames emitted by the bypass MAC to prevent feedback loops.
 ip -4 route replace default via "$BYPASS" dev "$LAN" table "$TEST_TABLE" || { test_clear; return 1; }
 if ! nft -f - <<EOF
table inet $TEST_NFT {
 chain mark_test {
  type filter hook prerouting priority mangle; policy accept;
  iifname "$LAN" ether saddr $client_mac ether saddr != $mac meta mark 0x0 meta l4proto tcp tcp dport 443 ip daddr 1.1.1.1 ip saddr $client ip daddr != 10.0.0.0/8 ip daddr != 172.16.0.0/12 ip daddr != 192.168.0.0/16 ip daddr != 127.0.0.0/8 ip daddr != 169.254.0.0/16 ip daddr != 224.0.0.0/4 counter meta mark set $TEST_MARK
 }
 chain test_egress {
  type filter hook postrouting priority mangle; policy accept;
  oifname "$LAN" meta mark $TEST_MARK ip saddr $client counter
 }
}
EOF
 then test_clear; return 1; fi
 if ! ip -4 rule add priority 10200 fwmark "$TEST_MARK" table "$TEST_TABLE"; then test_clear; return 1; fi
 # Non-disruptive FIB assertion: installation of a rule alone is not proof
 # it selects the bypass. Abort before claiming a live forwarding test.
 route_check=$(ip -4 route get 1.1.1.1 from "$client" iif "$LAN" mark "$TEST_MARK" 2>&1)
 case "$route_check" in
  *"via $BYPASS dev $LAN"*) say "策略路由 FIB 检查通过：测试设备 $client → $BYPASS";;
  *) say "策略路由 FIB 与预期不符：$route_check，已撤销测试规则"
     test_clear
     echo 'test policy route did not select configured bypass; rolled back' >&2
     return 1 ;;
 esac
 # Start watchdog with a separate lifetime. A failure to launch aborts testing.
 ( "$0" test-watchdog "$deadline" </dev/null >/dev/null 2>&1 & )
 sleep 1
 if ! [ -f "$TEST_PID" ] || ! kill -0 "$(cat "$TEST_PID")" 2>/dev/null; then
  test_clear; rm -f "$TEST_PID"; echo 'watchdog unavailable; test aborted' >&2; return 1
 fi
 say "单设备真实引流测试启动：$client 的 HTTPS 1.1.1.1:443 经 $BYPASS，未做 SNAT；60 秒到期或故障后撤销，其余流量直连"
 echo 'test_started'
}

# Network event callback. Do not start client forwarding from an interface event.
# A stale owned policy is withdrawn; direct mode remains the safe default.
event_check() {
 event_name=${1:-unknown}
 case "$event_name" in ifup|ifdown|ifupdate|reload) ;; *) return 0;; esac
 if [ -f "$FULL_OWNED" ]; then
  if ! nft list table inet "$NFT" >/dev/null 2>&1; then
   # Losing marking while retaining policy routes is a partial failure.
   # Remove only resources for which this installation has an owner marker.
   say "网络事件 $event_name：自有规则已丢失，撤销残留策略并恢复直连"
   clear_route
  elif [ "$(mode)" != auto ]; then
   say "网络事件 $event_name：当前直连模式，清理遗留的自有策略"
   clear_route
  fi
 fi
}
mode() { val mode direct; }
status() {
  echo "mode=$(mode)"
  echo "state=$(cat "$STATE" 2>/dev/null || echo direct)"
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then echo "daemon=running"; else echo "daemon=stopped"; fi
  echo "bypass=$(val bypass '')"
  echo "lan=$(val lan br-lan)"
  echo "ipv6=not-managed"
  echo "proxy_endpoint=$(val proxy_endpoint '')"
  echo "proxy_check=$(case "$(val proxy_endpoint '')" in '') echo transparent;; *) echo configured;; esac)"
  echo "forwarding_verified=$(val forwarding_verified 0)"
  echo "dns_strategy=client_primary_to_side_when_bypass"
  echo "ipv6_strategy=unchanged"
  echo "deployment=primary_only"
  echo "side_package_required=no"
  echo "test_client=$(val test_client '')"
  echo "forwarding_scope=ipv4_tcp_udp_external"
  echo "client_dns_redirect=$(if full_route_intact; then echo active; else echo disabled_or_partial; fi)"
  echo "client_dns_target=$(val bypass '')"
  echo "client_verified=no"
  echo "client_diagnostic=use_direct_device_browsing_to_accept"
  echo "route_validation=runtime-required"
  echo "health_evidence=side_icmp_then_routed_https"
  echo "client_return_path=direct_l2_from_side_unverified"
  echo "fallback_policy=main"
  echo "live_routing=$(if full_route_intact; then echo installed; else echo absent_or_partial; fi)"
  echo "dns_intercept_scope=client_queries_to_primary_only"
  echo "side_dns_reachable=$(if nslookup www.baidu.com "$(val bypass '')" >/dev/null 2>&1; then echo yes; else echo no; fi)"
  echo "active_policy_rule=$(ip -4 rule show | grep -c '^10201:' || true)"
  echo "lan_ingress_packets=$(nft list chain inet "$NFT" mark_in 2>/dev/null | awk '/counter packets/{for(i=1;i<=NF;i++)if($i=="packets"){print $(i+1);exit}}')"
  echo "side_egress_packets=$(nft list chain inet "$NFT" observe_to_side 2>/dev/null | awk '/counter packets/{for(i=1;i<=NF;i++)if($i=="packets"){print $(i+1);exit}}')"
  echo "network_event_handler=installed"
  echo "auto_safety_lock=client_end_to_end_unverified"
  echo "route_integrity=$(if full_route_intact; then echo intact; else echo missing_or_partial; fi)"
  echo "client_test_safety_lock=none"
  echo "dhcp_router=$(uci -q get dhcp.lan.dhcp_option 2>/dev/null | tr '\n' ',' || true)"
  test_status
  echo "notifications=$(case "$(val webhook '')" in https://*) echo configured;; *) echo disabled;; esac)"
}
daemon() {
  check_config || { say '配置检查失败，保持直连'; clear_route; exit 1; }
  echo "$$" > "$PID"
  trap 'clear_route; rm -f "$PID"; exit 0' INT TERM EXIT
  last=0; failures=0; successes=0
  clear_route; say '守护进程启动，安全默认直连'
  while :; do
    newmode=$(mode)
    if [ "$newmode" != auto ]; then
      [ "$(cat "$STATE")" = direct ] || { clear_route; say '切换为手动直连'; }
      sleep "$INTERVAL"; continue
    fi
    if health; then failures=0; successes=$((successes+1)); else successes=0; failures=$((failures+1)); fi
    now=$(date +%s)
    current=$(cat "$STATE" 2>/dev/null || echo direct)
    # fw4/netifd reload can remove nft chains while the daemon continues
    # reporting bypass mode. Withdraw any partial policy and rebuild only
    # after fresh consecutive successful health checks.
    if [ "$current" = bypass ] && ! full_route_intact; then
      say '检测到引流路由或 DNS 规则不完整，撤销自有残留并重新等待健康检查'
      clear_route
      current=direct
      successes=0
      last=$now
    fi
    if [ "$current" = bypass ] && [ "$failures" -ge "$FAIL" ]; then
      clear_route; last=$now; say '旁路由健康检查连续失败，已回退小米直连'; notify '旁路由故障：已切换到小米直连'
    elif [ "$current" = direct ] && [ "$successes" -ge "$RECOVER" ] && [ $((now-last)) -ge "$HOLD" ]; then
      if use_bypass; then last=$now; say '旁路由恢复稳定，已启用引流'; notify '旁路由恢复：已重新启用代理引流'; else last=$now; say '引流规则安装失败，继续直连'; notify '旁路由恢复但引流失败：保持小米直连'; fi
    fi
    sleep "$INTERVAL"
  done
}
start() {
  # Never wipe a live trial on an incidental "start" for an already-running daemon.
  [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && { echo already-running; return 0; }
  # A fresh service start must discard abandoned temporary policy rules.
  test_clear
  rm -f "$TEST_PID"
  probe_clear
  say '服务启动前已清理临时测试和探测规则'
  check_config || { echo 'config invalid; no changes made' >&2; return 1; }
  ( "$0" daemon </dev/null >/dev/null 2>&1 & )
  echo started
}
stop() {
  safe_test_stop
  probe_clear
  test_clear
  if [ -f "$PID" ]; then
    k=$(cat "$PID"); kill "$k" 2>/dev/null || true
    i=0; while kill -0 "$k" 2>/dev/null && [ "$i" -lt 6 ]; do sleep 1; i=$((i+1)); done
  fi
  clear_route
  rm -f "$PID"
  say '服务停止，保持小米直连'
}
case "${1:-status}" in
  start) start;; stop) stop;; restart) stop; start;;
  daemon) daemon;;
  status) status;;
  check) check_config && { check_base && echo healthy || echo unhealthy; };;
  topology-audit) topology_audit;;
  fallback-audit) fallback_audit;;
  event-check) event_check "${2:-unknown}";;
  health-report) health_report;;
  check-proxy)
    if ! check_config; then echo config_invalid
    elif ! check_base; then echo bypass_unreachable
    else
      endpoint=$(val proxy_endpoint '')
      if [ -z "$endpoint" ]; then
        if probe_transparent; then echo path_reachable_unverified; else echo path_unreachable; fi
      else
        if health; then echo proxy_healthy; else echo proxy_unhealthy; fi
      fi
    fi ;;
  safe-test-start) safe_test_start;;
  safe-test-worker) safe_test_worker "${2:-}";;
  safe-test-status) safe_test_status;;
  safe-test-stop) safe_test_stop;;
  test-start) test_start;;
  test-stop) test_clear; say '单设备测试手动停止';;
  test-watchdog) test_watchdog "$2";;
  direct) probe_clear; test_clear; uci set bypass_failover.main.mode=direct; uci commit bypass_failover; clear_route; say '用户选择直连';;
  auto)
    check_config || exit 1
    [ ! -f "$TEST_EXP" ] || { echo 'stop client trial first' >&2; exit 1; }
    uci set bypass_failover.main.mode=auto
    uci commit bypass_failover
    start
    say '用户开启全屋自动引流测试，按连续故障阈值回退'
    echo enabled;;
  preflight) check_config || exit 1; echo 'config=ok'; check_base && echo 'base=healthy' || echo 'base=unhealthy'; health && echo 'proxy=healthy' || echo 'proxy=unhealthy'; [ "$(val forwarding_verified 0)" = 1 ] && echo 'forwarding=approved' || echo 'forwarding=blocked';;
  clear-logs)
    # Only truncate this application's temporary event log.
    # Do not touch system logread or other packages' log files.
    : > "$LOG" || exit 1
    echo cleared;;
  logs) tail -n 100 "$LOG" 2>/dev/null || true;;
  *) echo 'usage: start|stop|restart|status|check|direct|auto|logs' >&2; exit 2;;
esac
