#!/bin/sh
set -eu
BIN=/usr/sbin/bypass-failover
case "${1:-status}" in
 boot-status)
  if /etc/init.d/bypass-failover enabled >/dev/null 2>&1; then echo enabled; else echo disabled; fi ;;
 boot-enable)
  /etc/init.d/bypass-failover enable
  echo enabled ;;
 boot-disable)
  /etc/init.d/bypass-failover disable
  echo disabled ;;
 health-report)
  # Offline/failed probe is a normal *result*, not an RPC transport failure.
  "$BIN" health-report || true ;;
 status|check|check-proxy|preflight|topology-audit|fallback-audit|safe-test-start|safe-test-status|safe-test-stop|logs|clear-logs|test-start|test-stop) exec "$BIN" "$1" ;;
 auto|direct) exec "$BIN" "$1" ;;
 set-bypass)
  current_mode=$(uci -q get bypass_failover.main.mode || echo direct)
  [ "$current_mode" = direct ] || { echo 'Switch to direct before changing bypass address' >&2; exit 2; }
  [ ! -f /tmp/bypass-failover-test.expires ] || { echo 'Stop temporary test first' >&2; exit 2; }
  ip="${2:-}"
  case "$ip" in ''|*[!0-9.]*|.*|*..*|*.) echo 'Invalid bypass IP' >&2; exit 2;; esac
  printf '%s\n' "$ip" | awk -F. 'NF==4 {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255 || length($i)>3) exit 1; exit 0} {exit 1}' || exit 2
  primary=$(uci -q get network.lan.ipaddr || true)
  [ "$ip" != "$primary" ] || { echo 'Bypass cannot be primary router' >&2; exit 2; }
  lan=$(uci -q get bypass_failover.main.lan || echo br-lan)
  ip -4 route get "$ip" | grep -q "dev $lan" || { echo 'Bypass is not on the LAN' >&2; exit 2; }
  uci set "bypass_failover.main.bypass=$ip"
  uci set "bypass_failover.main.proxy_endpoint="
  uci set "bypass_failover.main.forwarding_verified=0"
  uci set "bypass_failover.main.mode=direct"
  uci commit bypass_failover
  echo saved ;;
 set-proxy)
  bypass=$(uci -q get bypass_failover.main.bypass || true)
  endpoint="${2:-}"
  case "$endpoint" in
    http://"$bypass":*|socks5h://"$bypass":*) ;;
    *) echo 'Proxy endpoint must use the configured bypass IP' >&2; exit 2 ;;
  esac
  port=${endpoint##*:}
  case "$port" in ''|*[!0-9]*) exit 2;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || exit 2
  uci set "bypass_failover.main.proxy_endpoint=$endpoint"
  uci commit bypass_failover
  echo saved ;;
 set-client)
  ip="${2:-}"
  case "$ip" in ''|*[!0-9.]*|.*|*..*|*.) echo "Invalid client IPv4" >&2; exit 2;; esac
  printf '%s\n' "$ip" | awk -F. 'NF==4 {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255 || length($i)>3) exit 1; exit 0} {exit 1}' || exit 2
  uci set "bypass_failover.main.test_client=$ip"
  uci commit bypass_failover
  echo saved ;;
 *) echo 'Unsupported operation' >&2; exit 2 ;;
esac
