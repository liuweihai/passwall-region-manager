#!/bin/sh
# LuCI adapter: safe, read-only actions plus explicit verify start.
set -u
BIN=/usr/bin/passwall-region-manager
DIR=/tmp/prm-web
mkdir -p "$DIR"
case "${1:-}" in
  scan) "$BIN" scan ;;
  status) "$BIN" status ;;
  plan) "$BIN" plan ;;
  logs) tail -n 80 /tmp/passwall-region-manager.log 2>/dev/null || true ;;
  state)
    if [ -f "$DIR/exit-code" ]; then echo finished; exit 0; fi
    if [ -f "$DIR/pid" ]; then
      pid=$(cat "$DIR/pid" 2>/dev/null || true)
      case "$pid" in *[!0-9]*|'') echo invalid;; *)
        if kill -0 "$pid" 2>/dev/null; then echo running; else echo finished; fi ;;
      esac
    else echo idle; fi ;;
  start)
    case "${2:-}" in US|JP|HK|SG|TW|KR|ALL) region=$2;; *) echo 'Invalid region' >&2; exit 2;; esac
    if [ -f "$DIR/pid" ]; then
      pid=$(cat "$DIR/pid" 2>/dev/null || true)
      case "$pid" in *[!0-9]*|'') ;; *) kill -0 "$pid" 2>/dev/null && { echo 'A verification is already running' >&2; exit 2; };; esac
    fi
    # Refuse to run a second verification when CLI has an active lock.
    if [ -d /tmp/passwall-region-manager.lock ]; then
      echo 'CLI lock is present; wait for the task or inspect it first' >&2
      exit 2
    fi
    rm -f "$DIR/exit-code"
    total=$("$BIN" scan 2>/dev/null | awk -F '\t' -v c="$region" 'NF>=3 && (c=="ALL" || $1==c) {n++} END {print n+0}')
    printf '%s\n' "$total" > "$DIR/total"
    : > "$DIR/latest.log"
    ( "$BIN" verify "$region" > "$DIR/latest.log" 2>&1; printf '%s\n' "$?" > "$DIR/exit-code" ) </dev/null >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$DIR/pid"
    echo "started: $region" ;;
  latest) tail -n 100 "$DIR/latest.log" 2>/dev/null || true ;;
  progress)
    total=$(cat "$DIR/total" 2>/dev/null || echo 0)
    done_count=$(grep -Ec '验证通过:|验证失败:|HTTPS 未通过:|HTTPS正常但出口国家未确认:|出口国家不匹配:|探测失败:|未检测:' "$DIR/latest.log" 2>/dev/null || echo 0)
    printf '%s/%s\n' "$done_count" "$total" ;;
  *) echo 'usage: prm-web scan|status|plan|logs|state|start REGION|latest' >&2; exit 2;;
esac
