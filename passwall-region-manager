#!/bin/sh
# PassWall Region Manager v0.1.1 preview; OpenWrt ash; jq, curl, Xray required.
# safe by default: no UCI write except explicit apply, and no cron installed.
set -u
BASE=/etc/passwall-region-manager
STATE="$BASE/verified.tsv"
CONF="$BASE/regions.conf"
LOCK=/tmp/passwall-region-manager.lock
LOG=/tmp/passwall-region-manager.log
WORK=/tmp/passwall-region-probe
mkdir -p "$BASE" "$WORK"
[ -f "$CONF" ] && . "$CONF"
PROBE_PORT=${PROBE_PORT:-11881}
PROBE_TIMEOUT=${PROBE_TIMEOUT:-8}
CONNECT_TIMEOUT=${CONNECT_TIMEOUT:-3}
PARALLEL=${PARALLEL:-4}
VERIFY_REGION=${VERIFY_REGION:-ALL}
GEO_URL=${GEO_URL:-https://ipinfo.io/country}
PROBE_URL=${PROBE_URL:-https://www.google.com/generate_204}
TTL_SEC=${TTL_SEC:-1800}
FAIL_LIMIT=${FAIL_LIMIT:-2}
STARTUP_WAIT=${STARTUP_WAIT:-1}

# CC|matching alternatives (case-insensitive; full US token via emoji, keyword, US_/USA, etc)
REGIONS=${REGIONS:-US JP HK SG TW KR}
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG"; }
unlock() {
  [ -f "$LOCK/pid" ] && [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$" ] || return 0
  rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true
}
lock() {
  if ! mkdir "$LOCK" 2>/dev/null; then
    owner=$(cat "$LOCK/pid" 2>/dev/null || true)
    # Empty owner may be an in-progress lock acquisition: never steal it automatically.
    case "$owner" in ''|*[!0-9]*) log '存在无PID任务锁，拒绝自动删除；请人工检查'; return 2;; esac
    if kill -0 "$owner" 2>/dev/null; then
      log "已有任务运行 PID=$owner，拒绝并发"; return 2
    fi
    # Only reclaim a well-formed stale lock; failed cleanup still fails safely.
    [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$owner" ] || return 2
    rm -f "$LOCK/pid"
    rmdir "$LOCK" 2>/dev/null || { log '无法清理旧任务锁'; return 2; }
    log "已清理遗留任务锁 PID=$owner"
    mkdir "$LOCK" 2>/dev/null || return 2
  fi
  printf '%s\n' "$" > "$LOCK/pid" || return 2
  trap 'unlock' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
}
require() { command -v "$1" >/dev/null 2>&1 || { log "缺少工具：$1（预检不自动安装）"; return 1; }; }
node_name() { uci -q get "passwall.$1.remarks" || true; }
node_country() {
  n=$(node_name "$1")
  case "$n" in *美国*|*🇺🇸*|*USA*|*usa*|*United\ States*|*US_*|*us_*|*US-*|*us-*) echo US;;
    *日本*|*🇯🇵*|*Japan*|*JAPAN*|*JP_*|*JP-*) echo JP;;
    *香港*|*🇭🇰*|*Hong\ Kong*|*HK_*|*HK-*) echo HK;;
    *新加坡*|*🇸🇬*|*Singapore*|*SG_*|*SG-*) echo SG;;
    *台湾*|*臺灣*|*🇹🇼*|*Taiwan*|*TW_*|*TW-*) echo TW;;
    *韩国*|*韓國*|*🇰🇷*|*Korea*|*KR_*|*KR-*) echo KR;;
    *) echo '';; esac
}
# Enumerate only concrete nodes, ignore myshunt & anonymous subscription sections.
scan() {
  uci -q show passwall | sed -n 's/^passwall\.\([^.]*\)=nodes$/\1/p' | while IFS= read -r id; do
    [ "$(uci -q get "passwall.$id.type" || true)" = Xray ] || continue
    cc=$(node_country "$id")
    [ -n "$cc" ] && printf '%s\t%s\t%s\n' "$cc" "$id" "$(node_name "$id")"
  done
}
# Use separate throwaway Xray process, completely independent of running PassWall.
# V2 supports VLESS/REALITY/TCP only; other protocols are SKIPPED, not guessed.
probe() {
  id=$1; cc=$2; local_port=$3
  label=$(node_name "$id")
  if [ "$(uci -q get "passwall.$id" || true)" != nodes ]; then log "跳过: $label 原节点不存在"; return 1; fi
  if [ "$(uci -q get "passwall.$id.type" || true)" != Xray ] ||
     [ "$(uci -q get "passwall.$id.protocol" || true)" != vless ] ||
     [ "$(uci -q get "passwall.$id.reality" || true)" != 1 ] ||
     [ "$(uci -q get "passwall.$id.transport" || true)" != tcp ]; then
    log "未检测: $label 当前独立探测仅支持 Xray VLESS REALITY TCP"; return 1
  fi
  address=$(uci -q get "passwall.$id.address" || true)
  port=$(uci -q get "passwall.$id.port" || true)
  uuid=$(uci -q get "passwall.$id.uuid" || true)
  server=$(uci -q get "passwall.$id.tls_serverName" || true)
  pub=$(uci -q get "passwall.$id.reality_publicKey" || true)
  short=$(uci -q get "passwall.$id.reality_shortId" || true)
  finger=$(uci -q get "passwall.$id.fingerprint" || true)
  flow=$(uci -q get "passwall.$id.flow" || true)
  if [ -z "$address" ] || [ -z "$uuid" ] || [ -z "$server" ] || [ -z "$pub" ]; then
    log "未检测: $label 缺少必要的 REALITY 字段"; return 1
  fi
  case "$port" in *[!0-9]*|'') log "未检测: $label 端口格式错误"; return 1;; esac
  cfg="$run/probe-$local_port.json"
  out="$run/probe-$local_port.log"
  # Keep private node credentials in a root-only temporary work directory.
  (umask 077; jq -n --arg addr "$address" --argjson port "$port" --arg uid "$uuid" --arg sn "$server" \
    --arg pub "$pub" --arg short "$short" --arg fp "${finger:-chrome}" --arg flow "$flow" --argjson local "$local_port" '
    {log:{loglevel:"warning"},inbounds:[{listen:"127.0.0.1",port:$local,protocol:"socks",settings:{auth:"noauth",udp:false}}],
     outbounds:[{tag:"node",protocol:"vless",settings:{vnext:[{address:$addr,port:$port,users:[({id:$uid,encryption:"none",level:0} + (if $flow=="" then {} else {flow:$flow} end))]}]},streamSettings:{network:"tcp",security:"reality",realitySettings:{show:false,serverName:$sn,publicKey:$pub,shortId:$short,fingerprint:$fp,spiderX:"/"}}},
     {tag:"direct",protocol:"freedom",settings:{}}]}' > "$cfg") || { log "未检测: $label 生成配置失败"; return 1; }
  xray_bin=${XRAY:-/tmp/etc/passwall/bin/xray}
  [ -x "$xray_bin" ] || xray_bin=/usr/bin/xray
  if [ ! -x "$xray_bin" ]; then log "未检测: $label 找不到 Xray"; return 1; fi
  "$xray_bin" run -c "$cfg" > "$out" 2>&1 &
  pid=$!
  sleep "$STARTUP_WAIT"
  if ! kill -0 "$pid" 2>/dev/null; then
    log "探测失败: $label 独立 Xray 进程启动失败（可能是协议字段不兼容）"
    wait "$pid" 2>/dev/null || true
    return 1
  fi
  curl -q -4 -f -sS -o /dev/null --noproxy '' --socks5-hostname "127.0.0.1:$local_port" --connect-timeout "$CONNECT_TIMEOUT" --max-time "$PROBE_TIMEOUT" "$PROBE_URL" 2>/dev/null
  https_rc=$?
  if [ "$https_rc" -ne 0 ]; then
    log "HTTPS 未通过: $label curl错误码=$https_rc（不等同于PassWall节点不可用）"
    kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
    return 1
  fi
  got=$(curl -q -4 -f -sS --noproxy '' --socks5-hostname "127.0.0.1:$local_port" --connect-timeout "$CONNECT_TIMEOUT" --max-time "$PROBE_TIMEOUT" "$GEO_URL" 2>/dev/null | tr -d '\r\n \t')
  # Pipe status would mask curl errors in ash; empty/non-ISO response is classified unknown.
  kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
  case "$got" in
    [A-Z][A-Z])
      if [ "$got" = "$cc" ]; then log "验证通过: $label HTTPS正常，真实出口=$got"; return 0; fi
      log "出口国家不匹配: $label 预期=$cc 实测=$got"; return 1;;
    *)
      log "HTTPS正常但出口国家未确认: $label（地理位置服务可能失败；不判为节点不可用）"; return 1;;
  esac
}
# Pool records expire; only independently verified, current IDs are eligible.
valid() {
  id=$1; cc=$2
  [ -f "$STATE" ] || return 1
  now=$(date +%s)
  awk -F '\t' -v id="$id" -v cc="$cc" -v now="$now" -v ttl="$TTL_SEC" '$1==cc && $2==id && now-$3<=ttl && now >= $3 {good=1} END {exit !good}' "$STATE"
}
verify_pool() {
  require jq && require curl && require uci || return 1
  case "$PARALLEL" in 1|2|3|4|5|6) ;; *) log 'PARALLEL 只能为1至6'; return 2;; esac
  case "$VERIFY_REGION" in ALL|US|JP|HK|SG|TW|KR) ;; *) log '未知国家'; return 2;; esac
  run="$WORK/run-$$"; (umask 077; mkdir "$run") || return 1
  trap 'rm -rf "$run"; unlock' EXIT
  # The cache is read-only until the whole scan completes.
  scan > "$run/nodes.tsv"
  index=0; running=0
  while IFS="$(printf '\t')" read -r cc id name; do
    [ -n "$cc" ] || continue
    [ "$VERIFY_REGION" = ALL ] || [ "$cc" = "$VERIFY_REGION" ] || continue
    if valid "$id" "$cc"; then
      printf '%s\t%s\t%s\n' "$cc" "$id" "$(awk -F '\t' -v c="$cc" -v i="$id" '$1==c && $2==i {print $3; exit}' "$STATE")" > "$run/res-$index"
      index=$((index+1)); continue
    fi
    slot=$((running % PARALLEL))
    port=$((PROBE_PORT + slot))
    (
      if probe "$id" "$cc" "$port"; then
        printf '%s\t%s\t%s\n' "$cc" "$id" "$(date +%s)" > "$run/res-$index"
      else
        : > "$run/res-$index"
      fi
    ) &
    index=$((index+1)); running=$((running+1))
    if [ "$running" -ge "$PARALLEL" ]; then
      wait
      running=0
    fi
  done < "$run/nodes.tsv"
  wait
  # Preserve unexpired records for other countries when verifying a subset.
  tmp="$run/new.tsv"; : > "$tmp"
  if [ "$VERIFY_REGION" != ALL ] && [ -f "$STATE" ]; then
    awk -F '\t' -v target="$VERIFY_REGION" '$1!=target' "$STATE" >> "$tmp"
  fi
  for f in "$run"/res-*; do [ -f "$f" ] && cat "$f" >> "$tmp"; done
  # Do not invalidate a successful verified pool due to an interrupted run.
  cp "$tmp" "$STATE.new-$$" && chmod 600 "$STATE.new-$$" && mv "$STATE.new-$$" "$STATE"
  rm -rf "$run"
  log "验证完成，缓存合格节点: $(wc -l < "$STATE" | tr -d ' ')"
}
# AIGC->US, Streaming->JP, Proxy->SG; mapping customizable in regions.conf.
# This plan is not active until global.node = myshunt; do NOT change that automatically.
ROUTES=${ROUTES:-'AIGC:US Streaming:JP Proxy:SG'}
plan() {
  log "当前全局节点：$(uci -q get 'passwall.@global[0].node' || true)，分流总节点=myshunt"
  for pair in $ROUTES; do
    rule=${pair%%:*}; cc=${pair#*:}
    chosen=''
    if [ -f "$STATE" ]; then
      while IFS="$(printf '\t')" read -r c id ts; do
        [ "$c" = "$cc" ] || continue
        [ "$(node_country "$id")" = "$cc" ] || continue
        [ "$(uci -q get "passwall.$id" || true)" = nodes ] || continue
        if valid "$id" "$cc"; then chosen=$id; break; fi
      done < "$STATE"
    fi
    log "分流 $rule → $cc → ${chosen:-无已验证节点} $( [ -n "$chosen" ] && node_name "$chosen" )"
  done
}
apply() {
  [ "${2:-}" = 'I-UNDERSTAND' ] || { log '保护：必须执行 apply I-UNDERSTAND 才能写配置'; return 2; }
  # Refuse unless shunt is already main; protects currently working US_03 setup.
  [ "$(uci -q get 'passwall.@global[0].node' || true)" = myshunt ] || { log '未启用分流总节点，拒绝写规则。请先独立验证分流后手动启用。'; return 2; }
  [ -f "$STATE" ] || { log '无已验证节点池'; return 1; }
  cp -p /etc/config/passwall "$BASE/passwall-before-apply-$(date +%Y%m%d-%H%M%S)" || return 1
  changed=0
  for pair in $ROUTES; do
    rule=${pair%%:*}; cc=${pair#*:}
    case "$rule" in AIGC|Streaming|Proxy|ProxyGame|DirectGame|Direct) ;; *) log "拒绝未知分流规则 $rule"; continue;; esac
    [ -n "$(uci -q get "passwall.myshunt.$rule" || true)" ] || { log "分流规则不存在：$rule，跳过"; continue; }
    chosen=''
    while IFS="$(printf '\t')" read -r c id ts; do
      [ "$c" = "$cc" ] || continue
      [ "$(node_country "$id")" = "$cc" ] || continue
      [ "$(uci -q get "passwall.$id" || true)" = nodes ] || continue
      if valid "$id" "$cc"; then chosen=$id; break; fi
    done < "$STATE"
    if [ -n "$chosen" ]; then
      old=$(uci -q get "passwall.myshunt.$rule" || true)
      if [ "$old" != "$chosen" ]; then
        uci set "passwall.myshunt.$rule=$chosen" || return 1
        log "分流更新：$rule → $(node_name "$chosen")"
        changed=1
      fi
    else
      log "规则 $rule: 无合格 $cc 节点，保持原有配置（不退到其他地区）"
    fi
  done
  if [ "$changed" -eq 1 ]; then
    uci commit passwall || return 1
    /etc/init.d/passwall restart || log '警告：重启退出状态异常，请检查运行日志并手动回滚'
  else log '规则没有变化，不重启 PassWall'; fi
}
case "${1:-help}" in
  scan) lock || exit $?; scan ;;
  verify) lock || exit $?; VERIFY_REGION=${2:-ALL}; verify_pool ;;
  status) echo '===== 当前主节点 ====='; uci -q get 'passwall.@global[0].node'; echo '===== 已验证节点(国家 ID 时间戳) ====='; [ ! -f "$STATE" ] || cat "$STATE"; plan ;;
  plan) plan ;;
  apply) lock || exit $?; apply "$@" ;;
  help|*) cat <<'END'
PassWall 多地区管理器 v0.1.1 — 默认只读；不自动创建计划任务
  scan                 节点名称自动识别（未做出口验证）
  verify [US|JP|HK|SG|TW|KR]   最多4路并发，仅检测指定国家；30分钟内复用缓存
  plan                 预览 AIGC/Streaming/Proxy 可用地区节点（不写 UCI）
  status               查看当前主节点/缓存池及预览
  apply I-UNDERSTAND   仅当当前主节点为 myshunt 时，更新分流规则并重启 PassWall
不自动切换当前全局节点，不自动修改 DHCP/DNS，不保证其他协议可探测。
自动故障轮换和定时任务尚未接入：需要先验证独立探测和分流切换。
END
  ;;
esac
